{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swf.local/schemas/p3/decision-answer.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "answer",
    "selectedOptionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decisionId": {
      "type": "string",
      "pattern": "\\S"
    },
    "answer": {
      "type": "string",
      "pattern": "\\S"
    },
    "selectedOptionId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    }
  }
}
