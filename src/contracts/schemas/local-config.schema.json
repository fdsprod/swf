{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swf.local/schemas/p1/local-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "verification",
    "repositoryPath",
    "workspaceRoot",
    "artifactRoot",
    "worker",
    "sandboxExecutable",
    "commands",
    "allowedPaths",
    "protectedPaths",
    "blockedReadPaths",
    "verificationInputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "request": {
      "$ref": "../p0/run-fixture.schema.json#/definitions/workRequest"
    },
    "verification": {
      "$ref": "../p0/run-fixture.schema.json#/definitions/verificationContract"
    },
    "repositoryPath": {
      "$ref": "#/definitions/text"
    },
    "workspaceRoot": {
      "$ref": "#/definitions/text"
    },
    "artifactRoot": {
      "$ref": "#/definitions/text"
    },
    "sandboxExecutable": {
      "$ref": "#/definitions/text"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "prefixArgs", "timeoutSeconds"],
      "properties": {
        "executable": {
          "$ref": "#/definitions/text"
        },
        "prefixArgs": {
          "$ref": "#/definitions/args"
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specId", "executable", "args"],
        "properties": {
          "specId": {
            "$ref": "#/definitions/text"
          },
          "executable": {
            "$ref": "#/definitions/text"
          },
          "args": {
            "$ref": "#/definitions/args"
          }
        }
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "protectedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "blockedReadPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "verificationInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "executable",
        "prefixArgs",
        "timeoutSeconds",
        "authorizedResolver"
      ],
      "properties": {
        "kind": {
          "const": "github_issue_comments"
        },
        "executable": {
          "type": "string",
          "pattern": "\\S"
        },
        "prefixArgs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string"
          }
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "authorizedResolver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "login"],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "login": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "local_verification"
        },
        "maxRepairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment", "catalog", "common", "byRole"],
      "properties": {
        "assignment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["role"],
              "properties": {
                "role": {
                  "enum": ["tester", "designer"]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "design"],
              "properties": {
                "role": {
                  "const": "implementation"
                },
                "design": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind"],
                      "properties": {
                        "kind": {
                          "const": "none"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "path"],
                      "properties": {
                        "kind": {
                          "const": "provided"
                        },
                        "path": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "root", "entrypoint", "assets"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "root": {
                "type": "string",
                "pattern": "\\S"
              },
              "entrypoint": {
                "type": "string",
                "pattern": "\\S"
              },
              "assets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "common": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "contains": {
            "const": "ste"
          }
        },
        "byRole": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tester", "designer", "implementation"],
          "properties": {
            "tester": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "designer": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "implementation": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
