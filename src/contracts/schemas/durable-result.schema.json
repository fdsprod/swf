{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swf.local/schemas/p2/durable-result.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "not_implemented"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projection",
        "events"
      ],
      "properties": {
        "kind": {
          "const": "durable_result"
        },
        "projection": {
          "$ref": "#/definitions/projection"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projection",
        "events"
      ],
      "properties": {
        "kind": {
          "const": "durable_status"
        },
        "projection": {
          "$ref": "#/definitions/projection"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "issues"
      ],
      "properties": {
        "kind": {
          "const": "durable_error"
        },
        "code": {
          "enum": [
            "input_error",
            "store_busy",
            "not_found",
            "config_mismatch",
            "corrupt_store",
            "artifact_invalid",
            "ownership_uncertain"
          ]
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "artifact": {
      "$ref": "../p1/local-result.schema.json#/definitions/artifact"
    },
    "workspace": {
      "$ref": "../p1/local-result.schema.json#/definitions/workspace"
    },
    "contract": {
      "$ref": "../p1/local-evidence.schema.json#/properties/contract"
    },
    "graph": {
      "$ref": "../p0/cli-result.schema.json#/oneOf/2/properties/graph"
    },
    "state": {
      "$ref": "../p0/cli-result.schema.json#/definitions/state"
    },
    "outcome": {
      "$ref": "../p0/run-fixture.schema.json#/definitions/agentOutcome"
    },
    "result": {
      "$ref": "../p0/run-fixture.schema.json#/definitions/verificationResult"
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pid",
        "createdAt",
        "executable"
      ],
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "pattern": "\\S"
        },
        "executable": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "attemptIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "completionPath"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "completionPath": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "attempt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ordinal",
            "completionPath"
          ],
          "properties": {
            "kind": {
              "const": "reserved"
            },
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "completionPath": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ordinal",
            "completionPath",
            "process"
          ],
          "properties": {
            "kind": {
              "const": "running"
            },
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "completionPath": {
              "type": "string",
              "pattern": "\\S"
            },
            "process": {
              "$ref": "#/definitions/processIdentity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ordinal",
            "completionPath",
            "reason",
            "artifacts"
          ],
          "properties": {
            "kind": {
              "const": "interrupted"
            },
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "completionPath": {
              "type": "string",
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/artifact"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "ordinal",
            "completionPath",
            "outcome",
            "record"
          ],
          "properties": {
            "kind": {
              "const": "completed"
            },
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1
            },
            "completionPath": {
              "type": "string",
              "pattern": "\\S"
            },
            "outcome": {
              "$ref": "#/definitions/outcome"
            },
            "record": {
              "$ref": "#/definitions/artifact"
            }
          }
        }
      ]
    },
    "workspaceOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unplanned"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "workspace"
          ],
          "properties": {
            "kind": {
              "const": "intent"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "workspace": {
              "$ref": "#/definitions/workspace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "workspace"
          ],
          "properties": {
            "kind": {
              "const": "ready"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "workspace": {
              "$ref": "#/definitions/workspace"
            }
          }
        }
      ]
    },
    "verificationOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "idle"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "attemptId",
            "evidencePath"
          ],
          "properties": {
            "kind": {
              "const": "intent"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "evidencePath": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId",
            "attemptId",
            "evidencePath",
            "evidence"
          ],
          "properties": {
            "kind": {
              "const": "completed"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "evidencePath": {
              "type": "string",
              "pattern": "\\S"
            },
            "evidence": {
              "$ref": "#/definitions/artifact"
            }
          }
        }
      ]
    },
    "workerCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "attemptId",
        "process",
        "outcome"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "worker_completion"
        },
        "attemptId": {
          "type": "string",
          "pattern": "\\S"
        },
        "process": {
          "$ref": "../p1/local-evidence.schema.json#/definitions/process"
        },
        "outcome": {
          "$ref": "#/definitions/outcome"
        }
      }
    },
    "fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "contract",
            "graph",
            "maxStarts",
            "baseCommit"
          ],
          "properties": {
            "type": {
              "const": "RunCreated"
            },
            "contract": {
              "$ref": "#/definitions/contract"
            },
            "graph": {
              "$ref": "#/definitions/graph"
            },
            "maxStarts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "baseCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operationId",
            "workspace"
          ],
          "properties": {
            "type": {
              "const": "WorkspacePlanned"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "workspace": {
              "$ref": "#/definitions/workspace"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operationId"
          ],
          "properties": {
            "type": {
              "const": "WorkspaceReady"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attempt"
          ],
          "properties": {
            "type": {
              "const": "AttemptReserved"
            },
            "attempt": {
              "$ref": "#/definitions/attemptIdentity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attemptId",
            "process"
          ],
          "properties": {
            "type": {
              "const": "WorkerStarted"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "process": {
              "$ref": "#/definitions/processIdentity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attemptId",
            "reason",
            "artifacts"
          ],
          "properties": {
            "type": {
              "const": "AttemptInterrupted"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/artifact"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attemptId",
            "outcome",
            "record"
          ],
          "properties": {
            "type": {
              "const": "WorkerCompleted"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "outcome": {
              "$ref": "#/definitions/outcome"
            },
            "record": {
              "$ref": "#/definitions/artifact"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operationId",
            "attemptId",
            "evidencePath"
          ],
          "properties": {
            "type": {
              "const": "VerificationPlanned"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "attemptId": {
              "type": "string",
              "pattern": "\\S"
            },
            "evidencePath": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "operationId",
            "results",
            "issues",
            "evidence"
          ],
          "properties": {
            "type": {
              "const": "VerificationCompleted"
            },
            "operationId": {
              "type": "string",
              "pattern": "\\S"
            },
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/result"
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "evidence": {
              "$ref": "#/definitions/artifact"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "reason",
            "message"
          ],
          "properties": {
            "type": {
              "const": "RunStopped"
            },
            "reason": {
              "enum": [
                "worker_start_budget_exhausted",
                "recovery_failed"
              ]
            },
            "message": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "runId",
        "fact"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "runId": {
          "type": "string",
          "pattern": "\\S"
        },
        "fact": {
          "$ref": "#/definitions/fact"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "runId",
        "sequence",
        "contract",
        "graph",
        "state",
        "maxStarts",
        "workspace",
        "attempts",
        "verification",
        "baseCommit"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "contract": {
          "$ref": "#/definitions/contract"
        },
        "graph": {
          "$ref": "#/definitions/graph"
        },
        "state": {
          "$ref": "#/definitions/state"
        },
        "maxStarts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "workspace": {
          "$ref": "#/definitions/workspaceOperation"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        },
        "verification": {
          "$ref": "#/definitions/verificationOperation"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    }
  }
}
