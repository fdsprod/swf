{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome"
  ],
  "properties": {
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "message"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "completed",
                "blocked",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decision"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "decision_required"
            },
            "decision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question",
                "reason",
                "options",
                "impact",
                "reversible"
              ],
              "properties": {
                "question": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "description",
                      "consequences"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "consequences": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "impact": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "reversible": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    }
  }
}
