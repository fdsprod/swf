{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://swf.local/spec/p6/inspect.schema.json",
  "oneOf":[{"$ref":"#/definitions/inspection"},{"$ref":"#/definitions/error"}],
  "definitions":{
    "text":{"type":"string","minLength":1},
    "count":{"type":"integer","minimum":0},
    "budget":{"type":"object","additionalProperties":false,"required":["limit","consumed","remaining"],"properties":{"limit":{"$ref":"#/definitions/count"},"consumed":{"$ref":"#/definitions/count"},"remaining":{"$ref":"#/definitions/count"}}},
    "inspection":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","kind","observation","run","state","starts","repair","verification","decisions","github"],
      "properties":{
        "schemaVersion":{"const":1},"kind":{"const":"run_inspection"},"observation":{"const":"persisted"},
        "run":{"type":"object","additionalProperties":false,"required":["id","requestId","sequence","baseCommit"],"properties":{"id":{"$ref":"#/definitions/text"},"requestId":{"$ref":"#/definitions/text"},"sequence":{"type":"integer","minimum":1},"baseCommit":{"type":"string","pattern":"^[a-f0-9]{40}$"}}},
        "state":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/state"},
        "starts":{"type":"object","additionalProperties":false,"required":["limit","consumed","remaining","attempts"],"properties":{"limit":{"type":"integer","minimum":1},"consumed":{"$ref":"#/definitions/count"},"remaining":{"$ref":"#/definitions/count"},"attempts":{"type":"array","items":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/attempt"}}}},
        "repair":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"disabled"}}},{"type":"object","additionalProperties":false,"required":["kind","limit","consumed","remaining","reservations"],"properties":{"kind":{"const":"enabled"},"limit":{"$ref":"#/definitions/count"},"consumed":{"$ref":"#/definitions/count"},"remaining":{"$ref":"#/definitions/count"},"reservations":{"type":"array","items":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/repairReservation"}}}}]},
        "verification":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/verificationOperation"},
        "decisions":{"type":"array","items":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/decisionRecord"}},
        "github":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"disabled"}}},{"type":"object","additionalProperties":false,"required":["kind","issue","delivery","ci"],"properties":{"kind":{"const":"enabled"},"issue":{"type":"object","additionalProperties":false,"required":["id","number","url"],"properties":{"id":{"type":"integer","minimum":1},"number":{"type":"integer","minimum":1},"url":{"$ref":"#/definitions/text"}}},"delivery":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/deliveryProjection"},"ci":{"$ref":"https://swf.local/schemas/p2/durable-result.schema.json#/definitions/ciProjection"}}}]}
      }
    },
    "error":{"type":"object","additionalProperties":false,"required":["kind","code","issues"],"properties":{"kind":{"const":"durable_error"},"code":{"enum":["input_error","not_found","corrupt_store","artifact_invalid"]},"issues":{"type":"array","minItems":1,"items":{"$ref":"#/definitions/text"}}}}
  }
}
